@page
@model WebApplication1.Pages.View.OrderSuccessModel
@{
    ViewData["Title"] = "Đặt hàng thành công - CoffeeShop";
}

<main class="container mx-auto px-4 py-12 max-w-2xl min-h-[60vh]">
    <div class="bg-white rounded-xl shadow-lg p-6 md:p-8 text-center border-t-4 border-green-500">
        
        <div class="w-20 h-20 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-6">
            <i class="fas fa-check text-4xl text-green-600"></i>
        </div>
        
        <h1 class="text-2xl md:text-3xl font-bold text-gray-900 mb-2">Đặt hàng thành công!</h1>
        <p class="text-gray-600 mb-6">Cảm ơn bạn đã mua sắm tại CoffeeShop.</p>
        
        <div class="bg-gray-50 rounded-lg p-4 mb-6 inline-block">
            <p class="text-sm text-gray-600 mb-1">Mã đơn hàng của bạn</p>
            <span class="text-xl font-mono font-bold text-red-600">#@Model.CurrentOrder.OrderId</span>
            <p class="text-xs text-gray-500 mt-2">Mã đơn: @Model.CurrentOrder.OrderCode</p>
        </div>

        <!-- Danh sách sản phẩm -->
        <div class="text-left border-t border-b border-gray-100 py-4 mb-6 space-y-3">
            @foreach (var item in Model.CurrentOrder.OrderDetails)
            {
                <div class="flex justify-between items-center text-sm">
                    <div class="flex items-center gap-3">
                        <img src="~/@(item.Product?.ImageUrl ?? "img/sanpham/placeholder.png")" class="w-10 h-10 object-cover rounded border" onerror="this.src='/img/sanpham/placeholder.png'">
                        <span class="text-gray-800">@item.Product?.Name (x@(item.Quantity))</span>
                    </div>
                    <span class="font-medium text-gray-900">@((item.UnitPrice * item.Quantity).ToString("N0"))₫</span>
                </div>
            }
        </div>

        <!-- Tổng tiền -->
        <div class="flex justify-between items-center mb-8">
            <span class="text-gray-600 font-medium">Tổng cộng:</span>
            <span class="text-2xl font-bold text-red-600">@Model.CurrentOrder.TotalAmount.ToString("N0")₫</span>
        </div>

        <!-- Nút điều hướng -->
        <div class="flex flex-col sm:flex-row gap-3">
            <a asp-page="/Index" class="flex-1 py-3 bg-red-600 text-white rounded-lg font-semibold hover:bg-red-700 transition">
                Tiếp tục mua sắm
            </a>
            <a asp-page="/View/Orders" class="flex-1 py-3 bg-gray-100 text-gray-800 rounded-lg font-semibold hover:bg-gray-200 transition">
                Quản lý đơn hàng
            </a>
        </div>
        
        <p class="text-sm text-gray-500 mt-6">
            <i class="fas fa-info-circle mr-1"></i> Chúng tôi sẽ liên hệ với bạn để xác nhận đơn hàng trong thời gian sớm nhất.
        </p>
    </div>
</main>