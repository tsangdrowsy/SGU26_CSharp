@page
@model WebApplication1.Pages.View.CartModel
@{
    ViewData["Title"] = "Giỏ hàng";
}

<main class="flex-grow bg-gray-50 py-8 min-h-[60vh]">
    <div class="container mx-auto px-4">
        <!-- Thông báo -->
        @if (TempData["Error"] != null)
        {
            <div class="bg-red-50 border border-red-200 text-red-600 p-3 rounded mb-4 text-sm">
                <i class="fas fa-exclamation-circle mr-2"></i> @TempData["Error"]
            </div>
        }

        <div class="flex flex-col lg:flex-row gap-6">
            <!-- Cart Items (Left Column) -->
            <div class="w-full lg:w-2/3">
                <form method="post" asp-page-handler="UpdateCart" id="cartForm">
                    <!-- Cart Header -->
                    <div class="hidden md:grid grid-cols-[3.5fr,1.5fr,1.5fr,1.5fr] gap-4 bg-white p-4 rounded-t-lg shadow-sm border-b border-gray-200 text-sm font-semibold text-gray-600">
                        <span>Sản phẩm</span>
                        <span class="text-center">Đơn giá</span>
                        <span class="text-center">Số lượng</span>
                        <span class="text-center">Thành tiền</span>
                    </div>

                    <!-- Cart Items List -->
                    <div class="bg-white rounded-b-lg shadow-sm divide-y divide-gray-200">
                        @if (Model.CartItems.Any())
                        {
                            foreach (var item in Model.CartItems)
                            {
                                <div class="p-4 md:grid md:grid-cols-[3.5fr,1.5fr,1.5fr,1.5fr] md:gap-4 md:items-center">
                                    <!-- Info -->
                                    <div class="flex gap-4">
                                        <img src="~/@item.ImageUrl" alt="@item.ProductName" class="w-20 h-20 object-cover rounded" onerror="this.src='/img/sanpham/placeholder.svg'">
                                        <div>
                                            <a asp-page="/View/Product" asp-route-id="@item.ProductId" class="font-medium text-gray-800 hover:text-red-600 mt-2 line-clamp-2">
                                                @item.ProductName
                                            </a>
                                        </div>
                                    </div>
                                    
                                    <!-- Price -->
                                    <div class="hidden md:block text-center text-gray-700">
                                        @item.Price.ToString("N0")₫
                                    </div>
                                    
                                    <!-- Quantity -->
                                    <div class="flex justify-center mt-3 md:mt-0">
                                        <div class="flex items-center border border-gray-300 rounded">
                                            <button type="button" class="w-8 h-8 text-gray-600 bg-gray-50 hover:bg-gray-100" onclick="updateQty(this, -1)">-</button>
                                            <input type="number" name="quantities[@item.ProductId]" value="@item.Quantity" min="1" max="@item.Stock"
                                                   data-stock="@item.Stock" data-product-id="@item.ProductId"
                                                   class="qty-input w-12 text-center border-0 focus:ring-0 p-0 text-sm"
                                                   onkeydown="return blockInvalidChars(event)"
                                                   onchange="this.form.submit()">
                                            <button type="button" class="w-8 h-8 text-gray-600 bg-gray-50 hover:bg-gray-100" onclick="updateQty(this, 1)">+</button>
                                        </div>
                                    </div>

                                    <!-- Subtotal & Remove -->
                                    <div class="flex justify-between md:justify-end items-center gap-4 mt-3 md:mt-0">
                                        <span class="font-semibold text-red-600">
                                            @item.Subtotal.ToString("N0")₫
                                        </span>
                                        <button type="submit" asp-page-handler="RemoveItem" asp-route-productId="@item.ProductId" class="text-gray-400 hover:text-red-600" title="Xóa" onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này?');">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="p-8 text-center">
                                <i class="fas fa-shopping-basket text-5xl text-gray-300 mb-4"></i>
                                <h3 class="text-lg font-semibold text-gray-900 mb-2">Giỏ hàng trống</h3>
                                <p class="text-gray-500 mb-4">Chưa có sản phẩm nào trong giỏ hàng</p>
                                <a asp-page="/View/Shop" class="inline-block px-6 py-3 bg-red-600 text-white rounded-lg hover:bg-red-700 transition font-semibold">
                                    <i class="fas fa-shopping-bag mr-2"></i>Mua sắm ngay
                                </a>
                            </div>
                        }
                    </div>
                    
                    @if (Model.CartItems.Any())
                    {
                        <div class="mt-4 flex justify-between">
                            <button type="submit" asp-page-handler="ClearCart" class="text-sm text-red-600 hover:underline" onclick="return confirm('Xóa toàn bộ giỏ hàng?');">Xóa tất cả</button>
                            <button type="submit" class="text-sm text-gray-600 hover:text-red-600">Cập nhật giỏ hàng</button>
                        </div>
                    }
                </form>
            </div>

            <!-- Order Summary (Right Column) -->
            <div class="w-full lg:w-1/3">
                <div class="bg-white rounded-lg shadow-sm p-6 sticky top-24">
                    <h3 class="font-semibold text-lg mb-4">Tổng cộng giỏ hàng</h3>
                    <div class="space-y-3">
                        <div class="flex justify-between text-gray-600">
                            <span>Tạm tính (@Model.TotalItems sản phẩm)</span>
                            <span>@Model.TotalAmount.ToString("N0")₫</span>
                        </div>
                        <div class="border-t border-gray-200 pt-3 flex justify-between font-bold text-lg">
                            <span>Tổng cộng</span>
                            <span class="text-red-600">@Model.TotalAmount.ToString("N0")₫</span>
                        </div>
                    </div>
                    <div class="mt-6">
                        <a asp-page="/View/Checkout" class="block w-full bg-red-600 hover:bg-red-700 text-white text-center py-3 rounded-lg font-semibold transition @(Model.CartItems.Any() ? "" : "opacity-50 pointer-events-none")">
                            <i class="fas fa-credit-card mr-2"></i>Tiến hành thanh toán
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script>
        // Xử lý nút tăng giảm số lượng
        function updateQty(btn, change) {
            const input = btn.parentNode.querySelector('input');
            const stock = parseInt(input.dataset.stock) || 999;
            let val = parseInt(input.value);
            
            if (isNaN(val)) val = 1;
            let newVal = val + change;
            
            if (newVal < 1) newVal = 1;
            if (newVal > stock) newVal = stock;
            
            if (newVal !== val) {
                input.value = newVal;
                input.form.submit(); // Tự động gửi form đi khi bấm nút
            }
        }

        // Chặn nhập chữ cái vào ô số lượng
        function blockInvalidChars(event) {
            if (['-', 'e', 'E', '+', '.'].includes(event.key)) {
                event.preventDefault();
                return false;
            }
            if (event.key.length === 1 && !/[0-9]/.test(event.key)) {
                event.preventDefault();
                return false;
            }
            return true;
        }
    </script>
}