@page
@model WebApplication1.Pages.View.OrdersModel
@{
    ViewData["Title"] = "Quản lý đơn hàng - CoffeeShop";
}

<main class="flex-grow bg-gray-50 py-8">
    <div class="container mx-auto px-4">
        <div class="flex flex-col lg:flex-row gap-6">
            
            <!-- Sidebar (Giống trang MyAccount) -->
            <div class="lg:w-1/4">
                <nav class="bg-white rounded-lg shadow-sm overflow-hidden hidden lg:block">
                    <ul class="divide-y divide-gray-200">
                        <li>
                            <a asp-page="/View/MyAccount" class="flex items-center px-4 py-3 text-gray-700 hover:bg-gray-50 hover:text-red-600 transition">
                                <i class="fas fa-user w-5 mr-3 text-center"></i>
                                <span class="text-sm md:text-base">Thông tin tài khoản</span>
                            </a>
                        </li>
                        <li>
                            <a asp-page="/View/Orders" class="flex items-center px-4 py-3 bg-red-50 text-red-600 font-medium border-l-4 border-red-600">
                                <i class="fas fa-clipboard-list w-5 mr-3 text-center"></i>
                                <span class="text-sm md:text-base">Quản lý đơn hàng</span>
                            </a>
                        </li>
                        <li>
                            <a asp-page="/View/AddressBook" class="flex items-center px-4 py-3 text-gray-700 hover:bg-gray-50 hover:text-red-600 transition">
                                <i class="fas fa-map-marker-alt w-5 mr-3 text-center"></i>
                                <span class="text-sm md:text-base">Sổ địa chỉ</span>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>

            <!-- Main Content -->
            <div class="lg:w-3/4">
                
                <!-- Header & Filter -->
                <div class="bg-white rounded-lg shadow-sm p-4 md:p-6 mb-6">
                    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                        <h3 class="text-lg md:text-xl font-semibold text-gray-900">Đơn hàng của tôi</h3>
                        
                        <!-- Tìm kiếm -->
                        <form method="get" class="flex flex-col sm:flex-row gap-3">
                            <input type="hidden" name="status" value="@Model.StatusFilter" />
                            <div class="relative flex-1">
                                <input type="text" name="search" value="@Model.SearchQuery" placeholder="Tìm mã đơn hàng..."
                                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none pl-10 text-sm"
                                       oninput="this.value=this.value.replace(/[^0-9]/g,'')">
                                <i class="fas fa-search absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
                            </div>
                            <button type="submit" class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition whitespace-nowrap text-sm">
                                Tìm kiếm
                            </button>
                        </form>
                    </div>

                    <!-- Tabs Trạng thái -->
                    <div class="flex overflow-x-auto mt-6 border-b border-gray-200">
                        <a asp-page="/View/Orders" asp-route-status="all" asp-route-search="@Model.SearchQuery"
                           class="px-4 py-2 text-sm font-medium whitespace-nowrap transition border-b-2 @(Model.StatusFilter == "all" ? "border-red-600 text-red-600" : "border-transparent text-gray-600 hover:text-red-600")">
                            Tất cả (@Model.TotalOrders)
                        </a>
                        <a asp-page="/View/Orders" asp-route-status="Pending" asp-route-search="@Model.SearchQuery"
                           class="px-4 py-2 text-sm font-medium whitespace-nowrap transition border-b-2 @(Model.StatusFilter == "Pending" ? "border-red-600 text-red-600" : "border-transparent text-gray-600 hover:text-red-600")">
                            Chờ xác nhận
                        </a>
                        <a asp-page="/View/Orders" asp-route-status="Confirmed" asp-route-search="@Model.SearchQuery"
                           class="px-4 py-2 text-sm font-medium whitespace-nowrap transition border-b-2 @(Model.StatusFilter == "Confirmed" ? "border-red-600 text-red-600" : "border-transparent text-gray-600 hover:text-red-600")">
                            Đã xác nhận
                        </a>
                        <a asp-page="/View/Orders" asp-route-status="Delivered" asp-route-search="@Model.SearchQuery"
                           class="px-4 py-2 text-sm font-medium whitespace-nowrap transition border-b-2 @(Model.StatusFilter == "Delivered" ? "border-red-600 text-red-600" : "border-transparent text-gray-600 hover:text-red-600")">
                            Đã giao
                        </a>
                        <a asp-page="/View/Orders" asp-route-status="Cancelled" asp-route-search="@Model.SearchQuery"
                           class="px-4 py-2 text-sm font-medium whitespace-nowrap transition border-b-2 @(Model.StatusFilter == "Cancelled" ? "border-red-600 text-red-600" : "border-transparent text-gray-600 hover:text-red-600")">
                            Đã hủy
                        </a>
                    </div>
                </div>

                <!-- Danh sách Đơn hàng -->
                <div class="space-y-4">
                    @if (Model.OrdersList.Count == 0)
                    {
                        <div class="bg-white rounded-lg shadow-sm p-8 text-center">
                            <div class="w-20 h-20 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                                <i class="fas fa-shopping-bag text-4xl text-gray-400"></i>
                            </div>
                            <h3 class="text-lg font-semibold text-gray-900 mb-2">Chưa có đơn hàng nào</h3>
                            <p class="text-gray-600 mb-6">Bạn chưa đặt đơn hàng nào. Hãy bắt đầu mua sắm ngay!</p>
                            <a asp-page="/Index" class="inline-block px-6 py-3 bg-red-600 text-white rounded-lg hover:bg-red-700 transition">Tiếp tục mua sắm</a>
                        </div>
                    }
                    else
                    {
                        @foreach (var order in Model.OrdersList)
                        {
                            <div class="bg-white rounded-lg shadow-sm p-4 md:p-6 hover:shadow-md transition">
                                <!-- Order Header -->
                                <div class="flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-gray-100">
                                    <div class="flex items-center gap-4">
                                        <div>
                                            <span class="text-sm text-gray-500">Mã đơn hàng</span>
                                            <p class="font-semibold text-gray-900">#@order.OrderId</p>
                                        </div>
                                        <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
                                        <div>
                                            <span class="text-sm text-gray-500">Ngày đặt</span>
                                            <p class="font-medium">@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-3">
                                        <span class="px-3 py-1 rounded-full text-sm font-medium flex items-center gap-1 w-fit @Model.GetStatusBadgeClass(order.Status)">
                                            <i class="fas @Model.GetStatusIcon(order.Status)"></i> @Model.GetStatusText(order.Status)
                                        </span>
                                        <button class="text-gray-400 hover:text-gray-600" onclick="toggleOrderDetails(@order.OrderId)">
                                            <i class="fas fa-chevron-down" id="icon-@order.OrderId"></i>
                                        </button>
                                    </div>
                                </div>

                                <!-- Order Products (Ẩn/Hiện) -->
                                <div class="py-4 space-y-3 hidden transition-all" id="details-@order.OrderId">
                                    @foreach (var detail in order.OrderDetails)
                                    {
                                        <div class="flex items-start gap-4">
                                            <img src="~/@(detail.Product?.ImageUrl ?? "img/sanpham/placeholder.png")" alt="@detail.Product?.Name"
                                                 class="w-16 h-16 object-cover rounded-lg border border-gray-200" onerror="this.src='/img/sanpham/placeholder.png'">
                                            <div class="flex-1">
                                                <h4 class="font-medium text-gray-900">@detail.Product?.Name</h4>
                                                <div class="flex items-center justify-between mt-1">
                                                    <span class="text-sm text-gray-600">Số lượng: @detail.Quantity</span>
                                                    <span class="font-semibold text-red-600">@((detail.UnitPrice * detail.Quantity).ToString("N0"))₫</span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <!-- Order Footer -->
                                <div class="flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-gray-100">
                                    <div class="flex items-center gap-2">
                                        <span class="text-gray-600">Tổng tiền:</span>
                                        <span class="text-xl font-bold text-red-600">@order.TotalAmount.ToString("N0")₫</span>
                                    </div>
                                    <div class="flex gap-2">
                                        @if (order.Status == "Pending")
                                        {
                                            <button class="px-4 py-2 text-sm border border-gray-300 rounded-lg hover:bg-gray-50 transition" onclick="cancelOrder(@order.OrderId)">
                                                Hủy đơn
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>

                <!-- Phân trang -->
                @if (Model.TotalPages > 1)
                {
                    <div class="flex justify-center mt-8">
                        <nav class="flex items-center gap-2 flex-wrap justify-center">
                            @if (Model.CurrentPage > 1)
                            {
                                <a asp-page="/View/Orders" asp-route-page="@(Model.CurrentPage - 1)" asp-route-status="@Model.StatusFilter" asp-route-search="@Model.SearchQuery"
                                   class="w-10 h-10 flex items-center justify-center rounded-lg border border-gray-300 hover:bg-gray-50 transition">
                                    <i class="fas fa-chevron-left text-sm"></i>
                                </a>
                            }

                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                if (i == Model.CurrentPage)
                                {
                                    <span class="w-10 h-10 flex items-center justify-center rounded-lg bg-red-600 text-white">@i</span>
                                }
                                else if (i == 1 || i == Model.TotalPages || (i >= Model.CurrentPage - 2 && i <= Model.CurrentPage + 2))
                                {
                                    <a asp-page="/View/Orders" asp-route-page="@i" asp-route-status="@Model.StatusFilter" asp-route-search="@Model.SearchQuery"
                                       class="w-10 h-10 flex items-center justify-center rounded-lg border border-gray-300 hover:bg-gray-50 transition">@i</a>
                                }
                                else if (i == Model.CurrentPage - 3 || i == Model.CurrentPage + 3)
                                {
                                    <span class="w-10 h-10 flex items-center justify-center">...</span>
                                }
                            }

                            @if (Model.CurrentPage < Model.TotalPages)
                            {
                                <a asp-page="/View/Orders" asp-route-page="@(Model.CurrentPage + 1)" asp-route-status="@Model.StatusFilter" asp-route-search="@Model.SearchQuery"
                                   class="w-10 h-10 flex items-center justify-center rounded-lg border border-gray-300 hover:bg-gray-50 transition">
                                    <i class="fas fa-chevron-right text-sm"></i>
                                </a>
                            }
                        </nav>
                    </div>
                }
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script>
        // Toggle hiển thị chi tiết đơn hàng
        function toggleOrderDetails(orderId) {
            const details = document.getElementById(`details-${orderId}`);
            const icon = document.getElementById(`icon-${orderId}`);
            
            if (details.classList.contains('hidden')) {
                details.classList.remove('hidden');
                icon.classList.remove('fa-chevron-down');
                icon.classList.add('fa-chevron-up');
            } else {
                details.classList.add('hidden');
                icon.classList.remove('fa-chevron-up');
                icon.classList.add('fa-chevron-down');
            }
        }

        function cancelOrder(orderId) {
            if (confirm('Bạn có chắc chắn muốn hủy đơn hàng này?')) {
                // Phần code C# để cập nhật trạng thái đơn sang Cancelled sẽ được viết sau
                alert('Chức năng hủy đơn đang được phát triển!');
            }
        }
    </script>
}