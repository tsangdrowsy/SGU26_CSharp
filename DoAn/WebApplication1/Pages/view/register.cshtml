@page
@model WebApplication1.Pages.View.RegisterModel
@{
    ViewData["Title"] = "Đăng ký - NVBPlay";
}

<main id="main" class="bg-white mt-10 mb-20">
    <div class="page-wrapper my-account">
        <div class="container mx-auto px-5" role="main">
            <div class="woocommerce">
                <div class="account-container lightbox-inner max-w-6xl mx-auto">
                    <div class="flex flex-col md:flex-row">
                        
                        <!-- Banner Image -->
                        <div class="hidden md:block banner-login md:w-3/4 mr-10">
                            <img decoding="async" src="https://nvbplay.vn/wp-content/themes/nvbplayvn/assets/img/Login-Place.png"
                                 alt="Banner Register" title="My account" class="w-full h-full object-cover"
                                 style="min-height: 600px;">
                        </div>

                        <!-- Register Form -->
                        <div class="md:w-1/4 flex items-center mt-3 justify-center md:p-4 bg-white">
                            <div class="w-full">
                                <h1 class="text-center text-lg font-medium mb-4">Đăng ký tài khoản</h1>
                                
                                <!-- Thông báo lỗi chung -->
                                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                                {
                                    <div class="bg-red-50 border border-red-200 text-red-600 p-3 rounded mb-4 text-sm">
                                        @Model.ErrorMessage
                                    </div>
                                }
                                
                                <!-- Hiển thị lỗi Validation tổng hợp (nếu có) -->
                                <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm mb-2"></div>

                                <form id="registerForm" class="space-y-4 pb-8" method="post" novalidate>
                                    
                                    <!-- Tên đăng nhập -->
                                    <div>
                                        <input type="text" asp-for="Username" placeholder="Tên đăng nhập *"
                                               class="w-full px-3 py-2 border border-gray-300 rounded text-sm focus:border-red-600 focus:outline-none" required>
                                        <span asp-validation-for="Username" class="text-red-500 text-xs mt-1 block"></span>
                                    </div>

                                    <!-- Họ tên -->
                                    <div>
                                        <input type="text" asp-for="FullName" placeholder="Họ và tên *"
                                               class="w-full px-3 py-2 border border-gray-300 rounded text-sm focus:border-red-600 focus:outline-none" required>
                                        <span asp-validation-for="FullName" class="text-red-500 text-xs mt-1 block"></span>
                                    </div>

                                    <!-- Email -->
                                    <div>
                                        <input type="email" asp-for="Email" placeholder="Email *"
                                               class="w-full px-3 py-2 border border-gray-300 rounded text-sm focus:border-red-600 focus:outline-none" required>
                                        <span asp-validation-for="Email" class="text-red-500 text-xs mt-1 block"></span>
                                    </div>

                                    <!-- Số điện thoại -->
                                    <div>
                                        <input type="tel" asp-for="Phone" placeholder="Số điện thoại * (09xxxxxxxx)"
                                               class="w-full px-3 py-2 border border-gray-300 rounded text-sm focus:border-red-600 focus:outline-none" maxlength="10" required>
                                        <span asp-validation-for="Phone" class="text-red-500 text-xs mt-1 block"></span>
                                    </div>
                                    
                                    <!-- Mật khẩu -->
                                    <div>
                                        <input type="password" asp-for="Password" placeholder="Mật khẩu *"
                                               class="w-full px-3 py-2 border border-gray-300 rounded text-sm focus:border-red-600 focus:outline-none" required>
                                        <span asp-validation-for="Password" class="text-red-500 text-xs mt-1 block"></span>
                                    </div>

                                    <!-- Xác nhận mật khẩu -->
                                    <div>
                                        <input type="password" asp-for="ConfirmPassword" placeholder="Xác nhận mật khẩu *"
                                               class="w-full px-3 py-2 border border-gray-300 rounded text-sm focus:border-red-600 focus:outline-none" required>
                                        <span asp-validation-for="ConfirmPassword" class="text-red-500 text-xs mt-1 block"></span>
                                    </div>

                                    <!-- === ĐỊA CHỈ GIAO HÀNG === -->
                                    <div class="border-t pt-4 mt-4">
                                        <h4 class="font-medium text-gray-700 mb-3">Địa chỉ giao hàng</h4>

                                        <!-- Tỉnh/Thành phố -->
                                        <div class="mb-3">
                                            <input type="text" asp-for="City" placeholder="Tỉnh/Thành phố *"
                                                   class="w-full px-3 py-2 border border-gray-300 rounded text-sm focus:border-red-600 focus:outline-none" required>
                                            <span asp-validation-for="City" class="text-red-500 text-xs mt-1 block"></span>
                                        </div>

                                        <!-- Quận/Huyện -->
                                        <div class="mb-3">
                                            <input type="text" asp-for="District" placeholder="Quận/Huyện *"
                                                   class="w-full px-3 py-2 border border-gray-300 rounded text-sm focus:border-red-600 focus:outline-none" required>
                                            <span asp-validation-for="District" class="text-red-500 text-xs mt-1 block"></span>
                                        </div>

                                        <!-- Phường/Xã (Thêm mới để khớp với DB) -->
                                        <div class="mb-3">
                                            <input type="text" asp-for="Ward" placeholder="Phường/Xã *"
                                                   class="w-full px-3 py-2 border border-gray-300 rounded text-sm focus:border-red-600 focus:outline-none" required>
                                            <span asp-validation-for="Ward" class="text-red-500 text-xs mt-1 block"></span>
                                        </div>

                                        <!-- Địa chỉ chi tiết -->
                                        <div class="mb-3">
                                            <input type="text" asp-for="Address" placeholder="Địa chỉ chi tiết * (Số nhà, tên đường...)"
                                                   class="w-full px-3 py-2 border border-gray-300 rounded text-sm focus:border-red-600 focus:outline-none" required>
                                            <span asp-validation-for="Address" class="text-red-500 text-xs mt-1 block"></span>
                                        </div>
                                    </div>

                                    <!-- Điều khoản -->
                                    <div class="flex items-start gap-2 text-xs">
                                        <input type="checkbox" asp-for="Terms" class="mt-1">
                                        <label for="Terms" class="text-gray-600">Tôi đồng ý với <a href="#" class="text-[#FF3F1A] hover:underline">điều khoản sử dụng và chính sách bảo mật</a></label>
                                    </div>
                                    <span asp-validation-for="Terms" class="text-red-500 text-xs block"></span>

                                    <!-- Nút đăng ký -->
                                    <button type="submit" id="submitBtn"
                                            class="w-full bg-[#FF3F1A] text-white text-sm py-2.5 rounded hover:bg-red-600 font-medium transition mt-4">
                                        ĐĂNG KÝ
                                    </button>

                                    <!-- Link đăng nhập -->
                                    <div class="flex justify-center text-xs pt-2">
                                        <span class="text-gray-500">Đã có tài khoản?</span>
                                        <a asp-page="/View/Login" class="text-[#FF3F1A] font-bold ml-1 hover:underline">Đăng nhập</a>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<!-- Scripts cho trang Đăng Ký -->
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}