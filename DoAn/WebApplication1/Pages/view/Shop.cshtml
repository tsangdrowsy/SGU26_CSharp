@page
@model WebApplication1.Pages.View.ShopModel
@{
    ViewData["Title"] = "Cửa hàng - NVBPlay";
}

@section Styles {
    <style>
        /* Ẩn checkbox mặc định */
        .filter-btn {
            position: relative;
            display: block;
            width: 100%;
        }

            .filter-btn input[type="checkbox"] {
                position: absolute;
                opacity: 0;
                width: 0;
                height: 0;
            }

                /* Style cho nút khi được chọn */
                .filter-btn input[type="checkbox"]:checked + .btn-content {
                    background: #fef2f2;
                    border-color: #dc2626;
                    color: #dc2626;
                    font-weight: 500;
                }

                    .filter-btn input[type="checkbox"]:checked + .btn-content .check-icon {
                        opacity: 1;
                        transform: scale(1);
                    }

            .filter-btn .check-icon {
                opacity: 0;
                color: #dc2626;
                transition: all 0.2s ease;
            }

            .filter-btn .btn-content {
                border: 2px solid #e5e7eb;
                border-radius: 8px;
                transition: all 0.2s ease;
            }

            .filter-btn:hover .btn-content {
                border-color: #dc2626;
                background: #fef2f2;
            }

        .line-clamp-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
    </style>
}

<!-- Main Content -->
<main>
    <div class="container mx-auto px-4 py-6 md:py-8">

        <!-- Hiển thị các Tag bộ lọc đang áp dụng (Nếu có) -->
        @if (!string.IsNullOrEmpty(Model.Search) || (Model.CategoryIds != null && Model.CategoryIds.Length > 0) || (Model.SupplierIds != null && Model.SupplierIds.Length > 0))
        {
            <div class="mb-4">
                <div class="flex items-center justify-between mb-2">
                    <span class="text-sm font-medium text-gray-600">Bộ lọc đang áp dụng:</span>
                    <button onclick="resetFilters()" class="text-sm text-red-600 font-medium"><i class="fas fa-times-circle mr-1"></i>Xóa tất cả</button>
                </div>
                <div class="flex flex-wrap gap-2">
                    @if (!string.IsNullOrEmpty(Model.Search))
                    {
                        <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-red-50 text-red-600 rounded-full text-sm font-medium">
                            <span><i class="fas fa-search mr-1"></i>Tìm: "@Model.Search"</span>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="flex flex-col lg:flex-row gap-6">
            <!-- SIDEBAR FILTER (Desktop) -->
            <div class="hidden lg:block lg:w-80 flex-shrink-0">
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 sticky top-24">
                    <div class="p-5 border-b border-gray-200 flex items-center justify-between">
                        <h3 class="font-bold text-lg flex items-center"><i class="fas fa-filter mr-2 text-red-600"></i>Bộ lọc</h3>
                        <button type="button" onclick="resetFilters()" class="text-sm text-red-600 hover:text-red-700 font-medium transition"><i class="fas fa-undo mr-1"></i>Reset</button>
                    </div>

                    <!-- FORM LỌC -->
                    <form id="filterForm" method="get" onsubmit="event.preventDefault();" class="p-5 space-y-4 max-h-[calc(100vh-200px)] overflow-y-auto custom-scrollbar">
                        <input type="hidden" name="Search" value="@Model.Search" id="search-hidden" />

                        <!-- Danh mục (Đã khôi phục vòng lặp) -->
                        <div class="border-b border-gray-100 pb-4">
                            <h4 class="font-semibold text-gray-800 mb-3 flex items-center"><i class="fas fa-folder text-red-600 mr-2"></i>Danh mục</h4>
                            <div class="flex flex-col gap-2">
                                @foreach (var cat in Model.Categories)
                                {
                                    <label class="filter-btn cursor-pointer">
                                        <input type="checkbox" name="CategoryIds" value="@cat.CategoryId" @(Model.CategoryIds != null && Model.CategoryIds.Contains(cat.CategoryId) ? "checked" : "") />
                                        <div class="btn-content flex items-center justify-between p-2 rounded text-sm text-gray-700 bg-gray-50">
                                            <div class="flex items-center gap-2"><i class="fas fa-circle text-[6px]"></i><span>@cat.Name</span></div>
                                            <i class="fas fa-check-circle check-icon"></i>
                                        </div>
                                    </label>
                                }
                            </div>
                        </div>

                        <!-- Thương hiệu (Đã khôi phục vòng lặp) -->
                        <div class="border-b border-gray-100 pb-4">
                            <h4 class="font-semibold text-gray-800 mb-3 flex items-center"><i class="fas fa-tag text-red-600 mr-2"></i>Thương hiệu</h4>
                            <div class="flex flex-col gap-2">
                                @foreach (var sup in Model.Suppliers)
                                {
                                    <label class="filter-btn cursor-pointer">
                                        <input type="checkbox" name="SupplierIds" value="@sup.SupplierId" @(Model.SupplierIds != null && Model.SupplierIds.Contains(sup.SupplierId) ? "checked" : "") />
                                        <div class="btn-content flex items-center justify-between p-2 rounded text-sm text-gray-700 bg-gray-50">
                                            <div class="flex items-center gap-2"><i class="fas fa-circle text-[6px]"></i><span>@sup.Name</span></div>
                                            <i class="fas fa-check-circle check-icon"></i>
                                        </div>
                                    </label>
                                }
                            </div>
                        </div>

                        <!-- Khoảng giá -->
                        <div>
                            <h4 class="font-semibold text-gray-800 mb-3 flex items-center"><i class="fas fa-money-bill-wave text-red-600 mr-2"></i>Khoảng giá</h4>
                            <div class="flex items-center gap-2 mb-4">
                                <input type="number" id="input-minPrice" name="MinPrice" value="@Model.MinPrice" placeholder="Từ" class="w-full px-2 py-1.5 border rounded text-sm focus:border-red-500 focus:outline-none" />
                                <span>-</span>
                                <input type="number" id="input-maxPrice" name="MaxPrice" value="@Model.MaxPrice" placeholder="Đến" class="w-full px-2 py-1.5 border rounded text-sm focus:border-red-500 focus:outline-none" />
                            </div>

                            <input type="hidden" name="Sort" value="@Model.Sort" id="sort-hidden" />
                          
                        </div>
                    </form>
                </div>
            </div>

            <!-- PRODUCT GRID -->
            <div class="flex-1">
                <!-- Header with sort and count -->
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 mb-4 flex justify-between items-center">
                    <div class="text-sm text-gray-600">
                        Hiển thị <span class="font-bold">@Model.Products.Count</span> trong <span class="font-bold">@Model.TotalProducts</span> sản phẩm
                    </div>

                    <!-- Form Sắp xếp (ĐÃ XÓA SUBMIT ĐỂ DÙNG AJAX) -->
                    <div>
                        <select id="sort-select" class="border p-2 rounded text-sm outline-none">
                            <option value="newest" selected="@(Model.Sort == "newest")">Mới nhất</option>
                            <option value="price_asc" selected="@(Model.Sort == "price_asc")">Giá thấp nhất</option>
                            <option value="price_desc" selected="@(Model.Sort == "price_desc")">Giá cao nhất</option>
                            <option value="name_asc" selected="@(Model.Sort == "name_asc")">Tên A-Z</option>
                        </select>
                    </div>
                </div>

                <!-- Grid Sản phẩm (Chỉ gọi Partial View, ĐÃ XÓA đoạn code phân trang cũ bị lặp) -->
                <div id="product-container">
                    <partial name="_ProductGrid" model="Model" />
                </div>

            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script>
        // Hàm Debounce
        function debounce(func, wait) {
            let timeout;
            return function (...args) {
                clearTimeout(timeout);
                timeout = setTimeout(() => func.apply(this, args), wait);
            };
        }

        // Hàm gọi AJAX
        async function fetchProducts(pageNumber = 1) {
            const form = document.getElementById('filterForm');
            const formData = new FormData(form);
            const params = new URLSearchParams(formData);

            // Đồng bộ Sort từ dropdown bên ngoài vào form ẩn
            const sortValue = document.getElementById('sort-select').value;
            params.set('Sort', sortValue);

            params.set('PageNumber', pageNumber);

            const url = `/View/Shop?handler=ProductGrid&${params.toString()}`;
            const container = document.getElementById('product-container');

            container.style.opacity = '0.5';

            try {
                const response = await fetch(url);
                const html = await response.text();
                container.innerHTML = html;

                // Cập nhật URL
                const newUrl = `${window.location.pathname}?${params.toString()}`;
                window.history.pushState({}, '', newUrl);

            } catch (error) {
                console.error('Lỗi khi tải sản phẩm:', error);
            } finally {
                container.style.opacity = '1';
            }
        }

        // Bắt sự kiện Checkbox
        document.querySelectorAll('#filterForm input[type="checkbox"]').forEach(checkbox => {
            checkbox.addEventListener('change', () => fetchProducts(1));
        });

        // Bắt sự kiện Sắp xếp (Dùng ID mới, không submit form nữa)
        const sortSelect = document.getElementById('sort-select');
        if (sortSelect) {
            sortSelect.addEventListener('change', () => fetchProducts(1));
        }

        // Bắt sự kiện Giá
        const debouncedPrice = debounce(() => fetchProducts(1), 1000);
        document.getElementById('input-minPrice').addEventListener('input', debouncedPrice);
        document.getElementById('input-maxPrice').addEventListener('input', debouncedPrice);

        // Hàm Reset bộ lọc
        function resetFilters() {
            document.getElementById('filterForm').reset();
            document.getElementById('search-hidden').value = '';
            document.getElementById('sort-select').value = 'newest';
            fetchProducts(1);
        }
    </script>
}