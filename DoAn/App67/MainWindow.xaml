<Window
    x:Class="App67.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Quản Trị CoffeeShop">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Danh Sách Sản Phẩm" FontSize="28" FontWeight="Bold" Margin="20"/>

        <ListView Grid.Row="1" x:Name="ProductListView" Margin="20" BorderBrush="Gray" BorderThickness="1">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Padding="10">
                        <TextBlock Text="{Binding ProductId}" Width="50"/>
                        <TextBlock Text="{Binding Name}" Width="250" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SalePrice}" Width="150" Foreground="Red"/>
                        <TextBlock Text="{Binding StockQuantity}" Width="100"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>