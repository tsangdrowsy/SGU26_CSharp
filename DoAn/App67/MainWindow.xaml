<Window
    x:Class="App67.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Quản Trị CoffeeShop">

    <Grid>
        <NavigationView x:Name="NavView"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Left"
                        OpenPaneLength="220"
                        SelectionChanged="NavView_SelectionChanged">

            <NavigationView.PaneHeader>
                <TextBlock Text="Coffee Admin" FontSize="20" FontWeight="Bold" Margin="10,15" Foreground="Black"/>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Quản lý Sản phẩm" Tag="Products">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Quản lý Đơn hàng" Tag="Orders">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7BF;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- Khung chứa nội dung thay đổi -->
            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>