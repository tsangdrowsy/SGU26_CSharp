<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="App67.Pages.OrdersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:App67.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">



    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Quản Lý Đơn Hàng" FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button x:Name="btnRefresh" Content="Tải lại" Background="#3B82F6" Foreground="White" Click="btnRefresh_Click" CornerRadius="5" Padding="15,8" HorizontalAlignment="Right"/>
        </Grid>

        <!-- Bộ lọc: Tìm kiếm / Khoảng ngày / Trạng thái / Sắp xếp theo phường -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,0,0,15">
            <TextBox x:Name="txtSearch" PlaceholderText="Tìm theo ID, mã đơn, tên, SĐT..." Width="260" TextChanged="txtSearch_TextChanged"/>
            <TextBlock Text="Từ ngày:" VerticalAlignment="Center"/>
            <CalendarDatePicker x:Name="dpFromDate" PlaceholderText="Bắt đầu" Width="130" DateChanged="Filter_DateChanged"/>
            <TextBlock Text="Đến ngày:" VerticalAlignment="Center"/>
            <CalendarDatePicker x:Name="dpToDate" PlaceholderText="Kết thúc" Width="130" DateChanged="Filter_DateChanged"/>
            <ComboBox x:Name="cboStatusFilter" Width="160" SelectedIndex="0" SelectionChanged="Filter_SelectionChanged">
                <ComboBoxItem Content="Tất cả trạng thái" Tag=""/>
                <ComboBoxItem Content="Chờ duyệt" Tag="Pending"/>
                <ComboBoxItem Content="Đã duyệt" Tag="Confirmed"/>
                <ComboBoxItem Content="Đã giao" Tag="Delivered"/>
                <ComboBoxItem Content="Đã hủy" Tag="Cancelled"/>
            </ComboBox>
            <ComboBox x:Name="cboWardSort" Width="190" SelectedIndex="0" SelectionChanged="Filter_SelectionChanged">
                <ComboBoxItem Content="Mới nhất trước" Tag=""/>
                <ComboBoxItem Content="Phường/Xã A → Z" Tag="asc"/>
                <ComboBoxItem Content="Phường/Xã Z → A" Tag="desc"/>
            </ComboBox>
            <Button Content="Xóa lọc" Background="#6B7280" Foreground="White" Click="btnClearFilter_Click" CornerRadius="5" Padding="15,8"/>
            <TextBlock x:Name="txtResultCount" VerticalAlignment="Center" Foreground="#6B7280"/>
        </StackPanel>

        <!-- Bảng Danh sách Đơn hàng -->
        <ListView Grid.Row="2" x:Name="OrderListView" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" SelectionMode="Single">
            <ListView.Header>
                <Grid Background="#F3F4F6" Padding="15,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <!-- ID -->
                        <ColumnDefinition Width="170"/>
                        <!-- Mã đơn -->
                        <ColumnDefinition Width="140"/>
                        <!-- Ngày đặt -->
                        <ColumnDefinition Width="*"/>
                        <!-- Người nhận -->
                        <ColumnDefinition Width="110"/>
                        <!-- SĐT -->
                        <ColumnDefinition Width="140"/>
                        <!-- Phường -->
                        <ColumnDefinition Width="120"/>
                        <!-- Tổng tiền -->
                        <ColumnDefinition Width="100"/>
                        <!-- Trạng thái -->
                        <ColumnDefinition Width="230"/>
                        <!-- Hành động -->
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="ID" FontWeight="Bold" />
                    <TextBlock Text="Mã đơn" FontWeight="Bold" Grid.Column="1"/>
                    <TextBlock Text="Ngày đặt" FontWeight="Bold" Grid.Column="2"/>
                    <TextBlock Text="Người nhận" FontWeight="Bold" Grid.Column="3"/>
                    <TextBlock Text="SĐT" FontWeight="Bold" Grid.Column="4"/>
                    <TextBlock Text="Phường/Xã" FontWeight="Bold" Grid.Column="5"/>
                    <TextBlock Text="Tổng tiền" FontWeight="Bold" Grid.Column="6"/>
                    <TextBlock Text="Trạng thái" FontWeight="Bold" Grid.Column="7"/>
                    <TextBlock Text="Hành động" FontWeight="Bold" Grid.Column="8"/>
                </Grid>
            </ListView.Header>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="15,10" BorderBrush="#F3F4F6" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="230"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding OrderId}" Grid.Column="0" Foreground="#6B7280" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding OrderCode}" Grid.Column="1" Foreground="#111827" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding OrderDateString}" Grid.Column="2" Foreground="#111827" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ReceiverName}" Grid.Column="3" FontWeight="SemiBold" Foreground="#111827" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ReceiverPhone}" Grid.Column="4" Foreground="#6B7280" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Ward}" Grid.Column="5" Foreground="#6B7280" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding TotalAmountString}" Grid.Column="6" Foreground="#DC2626" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusString}" Grid.Column="7" FontWeight="SemiBold"
           Foreground="{Binding StatusColor}"
           VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="8" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <Button Content="Chi tiết" Background="#6B7280" Foreground="White" Click="btnViewDetails_Click" Tag="{Binding OrderId}" Padding="8,4" CornerRadius="4" FontSize="12"/>
                            <!-- Chỉ hiện khi đơn còn chuyển trạng thái được (Pending/Confirmed) -->
                            <Button Content="{Binding NextActionText}" Background="#10B981" Foreground="White" Click="btnConfirm_Click" Tag="{Binding OrderId}" Padding="8,4" CornerRadius="4" FontSize="12" Visibility="{Binding ActionVisibility}"/>
                            <Button Content="Hủy" Background="#EF4444" Foreground="White" Click="btnCancelOrder_Click" Tag="{Binding OrderId}" Padding="8,4" CornerRadius="4" FontSize="12" Visibility="{Binding ActionVisibility}"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Hộp thoại Xem chi tiết -->
        <ContentDialog x:Name="DetailDialog" Title="Chi tiết đơn hàng" CloseButtonText="Đóng" DefaultButton="Close">
            <ScrollViewer MaxHeight="450" Width="480">
                <StackPanel x:Name="DetailContentPanel" Spacing="6" />
            </ScrollViewer>
        </ContentDialog>
    </Grid>
</Page>
