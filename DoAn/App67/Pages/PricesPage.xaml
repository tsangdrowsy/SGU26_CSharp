<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="App67.Pages.PricesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:App67.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề và Thanh công cụ -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Quản Lý Giá Bán" FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="Giá bán = Giá nhập bình quân × (100% + Tỷ lệ lãi). Giá nhập bình quân được tính lại mỗi khi hoàn thành phiếu nhập." Foreground="#6B7280" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
            <Button x:Name="btnCategoryProfit" Content="Đặt % lãi theo danh mục" Background="#8B5CF6" Foreground="White" Click="btnCategoryProfit_Click" CornerRadius="5" Padding="15,8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <!-- Bộ lọc -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,0,0,15">
            <TextBox x:Name="txtSearch" PlaceholderText="Tìm theo tên, mã hoặc ID sản phẩm..." Width="300" TextChanged="txtSearch_TextChanged"/>
            <ComboBox x:Name="cboFilterCategory" Width="200" SelectionChanged="cboFilterCategory_SelectionChanged"/>
            <Button Content="Tải lại" Background="#3B82F6" Foreground="White" Click="btnRefresh_Click" CornerRadius="5" Padding="15,8"/>
            <TextBlock x:Name="txtResultCount" VerticalAlignment="Center" Foreground="#6B7280"/>
        </StackPanel>

        <!-- Bảng giá -->
        <ListView Grid.Row="2" x:Name="PriceListView" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" SelectionMode="Single">
            <ListView.Header>
                <Grid Background="#F3F4F6" Padding="15,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="ID" FontWeight="Bold"/>
                    <TextBlock Text="Mã SP" FontWeight="Bold" Grid.Column="1"/>
                    <TextBlock Text="Tên Sản Phẩm" FontWeight="Bold" Grid.Column="2"/>
                    <TextBlock Text="Danh Mục" FontWeight="Bold" Grid.Column="3"/>
                    <TextBlock Text="Giá nhập BQ" FontWeight="Bold" Grid.Column="4"/>
                    <TextBlock Text="% Lãi" FontWeight="Bold" Grid.Column="5"/>
                    <TextBlock Text="Giá Bán" FontWeight="Bold" Grid.Column="6"/>
                    <TextBlock Text="Hành động" FontWeight="Bold" Grid.Column="7"/>
                </Grid>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="15,10" BorderBrush="#F3F4F6" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ProductId}" Foreground="#6B7280" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Code}" Grid.Column="1" Foreground="#6B7280" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Name}" Grid.Column="2" FontWeight="SemiBold" Foreground="#111827" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding CategoryName}" Grid.Column="3" Foreground="#6B7280" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding CostPriceString}" Grid.Column="4" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ProfitRateString}" Grid.Column="5" Foreground="#8B5CF6" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SalePriceString}" Grid.Column="6" Foreground="#DC2626" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Grid.Column="7" Content="Sửa % lãi" Background="#3B82F6" Foreground="White" Click="btnEditProfit_Click" Tag="{Binding ProductId}" Padding="8,4" CornerRadius="4" FontSize="12" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Dialog: sửa % lãi 1 sản phẩm -->
        <ContentDialog x:Name="ProductProfitDialog" Title="Sửa tỷ lệ lãi" PrimaryButtonText="Lưu" CloseButtonText="Hủy" DefaultButton="Primary" PrimaryButtonClick="ProductProfitDialog_PrimaryButtonClick">
            <StackPanel Spacing="10" Width="360">
                <TextBlock x:Name="txtProfitProductName" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock x:Name="txtProfitCostPrice" Foreground="#6B7280"/>
                <TextBox x:Name="txtProfitRate" Header="Tỷ lệ lãi (%) (0 - 500)" InputScope="Number" TextChanged="txtProfitRate_TextChanged"/>
                <TextBlock x:Name="txtProfitPreview" FontWeight="SemiBold" Foreground="#DC2626"/>
                <TextBlock x:Name="txtProfitError" Foreground="Red" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12"/>
            </StackPanel>
        </ContentDialog>

        <!-- Dialog: áp % lãi cho cả danh mục -->
        <ContentDialog x:Name="CategoryProfitDialog" Title="Đặt % lãi cho cả danh mục" PrimaryButtonText="Áp dụng" CloseButtonText="Hủy" DefaultButton="Primary" PrimaryButtonClick="CategoryProfitDialog_PrimaryButtonClick">
            <StackPanel Spacing="10" Width="360">
                <ComboBox x:Name="cboProfitCategory" Header="Danh mục (*)" HorizontalAlignment="Stretch"/>
                <TextBox x:Name="txtCategoryProfitRate" Header="Tỷ lệ lãi (%) (0 - 500)" InputScope="Number"/>
                <TextBlock Text="Tất cả sản phẩm trong danh mục sẽ được đặt cùng tỷ lệ lãi này, giá bán tự tính lại." Foreground="#6B7280" FontSize="12" TextWrapping="Wrap"/>
                <TextBlock x:Name="txtCategoryProfitError" Foreground="Red" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12"/>
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>
