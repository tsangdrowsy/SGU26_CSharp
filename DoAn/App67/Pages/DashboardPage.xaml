<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="App67.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:App67.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

  

        <ScrollViewer>
            <Grid Padding="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Tiêu đề -->
                <TextBlock Grid.Row="0" Text="Tổng Quan Hệ Thống" FontSize="28" FontWeight="Bold" Margin="0,0,0,20" Foreground="#111827"/>

                <!-- PHẦN 1: 4 THẺ THỐNG KÊ (KPI) -->
                <Grid Grid.Row="1" Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Thẻ Doanh Thu -->
                    <Border Grid.Column="0" Background="#E0F2FE" CornerRadius="10" Padding="20" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Tổng Doanh Thu" FontWeight="SemiBold" Foreground="#0284C7"/>
                            <TextBlock x:Name="txtRevenue" Text="0 ₫" FontSize="28" FontWeight="Bold" Foreground="#0369A1" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Thẻ Tổng Đơn Hàng -->
                    <Border Grid.Column="1" Background="#DCFCE7" CornerRadius="10" Padding="20" Margin="10,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Tổng Đơn Hàng" FontWeight="SemiBold" Foreground="#15803D"/>
                            <TextBlock x:Name="txtTotalOrders" Text="0" FontSize="28" FontWeight="Bold" Foreground="#166534" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Thẻ Khách Hàng -->
                    <Border Grid.Column="2" Background="#F3E8FF" CornerRadius="10" Padding="20" Margin="10,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Khách Hàng" FontWeight="SemiBold" Foreground="#7E22CE"/>
                            <TextBlock x:Name="txtCustomers" Text="0" FontSize="28" FontWeight="Bold" Foreground="#6B21A8" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Thẻ Đơn Chờ Duyệt -->
                    <Border Grid.Column="3" Background="#FEF3C7" CornerRadius="10" Padding="20" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Đơn Chờ Duyệt" FontWeight="SemiBold" Foreground="#B45309"/>
                            <TextBlock x:Name="txtPendingOrders" Text="0" FontSize="28" FontWeight="Bold" Foreground="#92400E" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- PHẦN 2: DANH SÁCH (2 CỘT) -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6*"/>
                        <!-- Cột Đơn hàng rộng hơn -->
                        <ColumnDefinition Width="4*"/>
                        <!-- Cột Cảnh báo hẹp hơn -->
                    </Grid.ColumnDefinitions>

                    <!-- Cột trái: Đơn hàng mới nhất -->
                    <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="15" Margin="0,0,10,0" BorderBrush="#E5E7EB" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Đơn Hàng Mới Nhất" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" Foreground="#111827"/>

                            <ListView Grid.Row="1" x:Name="RecentOrdersListView">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,10" BorderBrush="#F3F4F6" BorderThickness="0,0,0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding OrderIdString}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding ReceiverName}" Grid.Column="1" Foreground="#6B7280"/>
                                            <TextBlock Text="{Binding TotalAmountString}" Grid.Column="2" Foreground="#DC2626" FontWeight="Bold" TextAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- Cột phải: Cảnh báo hết hàng -->
                    <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="15" Margin="10,0,0,0" BorderBrush="#E5E7EB" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Cảnh Báo Tồn Kho" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" Foreground="#DC2626"/>

                            <ListView Grid.Row="1" x:Name="LowStockListView">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,10" BorderBrush="#F3F4F6" BorderThickness="0,0,0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding StockString}" Grid.Column="1" Foreground="#DC2626" FontWeight="Bold" Margin="10,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Page>