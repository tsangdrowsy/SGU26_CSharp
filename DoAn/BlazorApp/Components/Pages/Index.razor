    // Carousel
    private void NextSlide() { CurrentSlide = (CurrentSlide + 1) % Banners.Count; ResetCarouselTimer(); }
    private void PrevSlide() { CurrentSlide = (CurrentSlide - 1 + Banners.Count) % Banners.Count; ResetCarouselTimer(); }
    private void GoToSlide(int index) { CurrentSlide = index; ResetCarouselTimer(); }
    private void ResetCarouselTimer() { _carouselTimer?.Stop(); _carouselTimer?.Start(); }

    // Category menu
    private void OpenCategoryMenu() { _menuCloseTimer?.Stop(); IsCategoryMenuOpen = true; }
    private void CloseCategoryMenu()
    {
        _menuCloseTimer?.Dispose();
        _menuCloseTimer = new System.Timers.Timer(200);
        _menuCloseTimer.AutoReset = false;
        _menuCloseTimer.Elapsed += (s, e) => InvokeAsync(() =>
        {
            IsCategoryMenuOpen = false;
            ActiveCategoryId = -1;
            StateHasChanged();
        });
        _menuCloseTimer.Start();
    }
    private void SetActiveCategory(int id) => ActiveCategoryId = id;

    // Cart
    private void ToggleCart() => IsCartOpen = !IsCartOpen;
    private void AddToCart(Product product)
    {
        var existing = CartItems.FirstOrDefault(c => c.Id == product.Id);
        if (existing != null) existing.Quantity++;
        else CartItems.Add(new CartItem
        {
            Id = product.Id,
            Name = product.Name,
            ImageUrl = product.ImageUrl,
            Price =
product.Price,
            Quantity = 1
        });
        CartItemCount = CartItems.Sum(c => c.Quantity);
        CartTotal = CartItems.Sum(c => c.Price * c.Quantity);
        ShowToast($"Đã thêm \"{product.Name}\" vào giỏ hàng");
    }
    private void RemoveFromCart(int productId)
    {
        var item = CartItems.FirstOrDefault(c => c.Id == productId);
        if (item != null)
        {
            CartItems.Remove(item);
            CartItemCount = CartItems.Sum(c => c.Quantity);
            CartTotal = CartItems.Sum(c => c.Price * c.Quantity);
        }
    }

    // Auth
    private void ToggleAuthModal() => IsAuthModalOpen = !IsAuthModalOpen;
    private void HandleLogin() { ShowToast("Đăng nhập thành công!"); IsAuthModalOpen = false; }
    private void HandleForgotPassword()
    {
        ShowToast("Đã gửi liên kết đặt lại mật khẩu đến email của bạn"); AuthMode =
AuthView.Login;
    }

    // Search
    private void HandleSearchKeydown(KeyboardEventArgs e) { if (e.Key == "Enter") ExecuteSearch(); }
    private void ExecuteSearch()
    {
        if (!string.IsNullOrWhiteSpace(SearchQuery))
            ShowToast($"Tìm kiếm: {SearchQuery} (sẽ nối API sau)");
    }

    // Newsletter
    private void SubscribeNewsletter()
    {
        ShowNewsletterSuccess = false;
        NewsletterError = "";
        if (string.IsNullOrWhiteSpace(NewsletterEmail) || !NewsletterEmail.Contains("@"))
        {
            NewsletterError = "Vui lòng nhập địa chỉ email hợp lệ.";
            return;
        }
        ShowNewsletterSuccess = true;
        NewsletterEmail = "";
    }

    // Toast
    private void ShowToast(string message)
    {
        ToastMessage = message;
        _toastTimer?.Dispose();
        _toastTimer = new System.Timers.Timer(3000);
        _toastTimer.AutoReset = false;
        _toastTimer.Elapsed += (s, e) => InvokeAsync(() => { ToastMessage = ""; StateHasChanged(); });
        _toastTimer.Start();
    }

    public void Dispose()
    {
        _carouselTimer?.Dispose();
        _toastTimer?.Dispose();
        _menuCloseTimer?.Dispose();
    }
}