@page "/"
@rendermode InteractiveServer
@implements IDisposable


<!-- TOP BAR -->
<div class="bg-neutral-900 text-neutral-300 text-xs">
    <div class="max-w-7xl mx-auto px-5 py-2 flex items-center justify-between">
        <div class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd"
                      d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                      clip-rule="evenodd" />
            </svg>
            <span class="text-neutral-100">Trang thương mại điện tử chính thức của Tập Đoàn Trung Nguyên Legend</span>
        </div>
        <div class="flex items-center gap-4">
            <a href="/b2b-customer-create" class="hover:text-white transition-colors">Trở thành đối tác</a>
            <button @onclick="ToggleAuthModal" class="hover:text-white transition-colors">Đăng nhập</button>
            <a href="tel:19006016" class="hover:text-white transition-colors">1900 6016</a>
            <a href="/guarantee/check/" class="hover:text-white transition-colors">Kiểm tra bảo hành</a>
            <a href="/customer/account/create/" class="hover:text-white transition-colors">Đăng ký</a>
        </div>
    </div>
</div>

<!-- HEADER -->
<header class="bg-white border-b border-neutral-100 sticky top-0 z-50">

    <!-- Logo row: div holds the layout, only the <a><img/></a> is clickable -->
    <div class="flex justify-center items-center pt-5">
        <a href="/" aria-label="Trang chủ" class="inline-block">
            <img src="https://cafe.net.vn/media/logo/websites/1/logo-TGCF-224.png" alt="Thế Giới Cà Phê"
                 class="h-14 w-auto object-contain" />
        </a>
    </div>

    <div class="max-w-7xl mx-auto px-5 py-3 flex items-center gap-2">

        <nav class="bg-white shrink-0">
            <div class="flex items-stretch">
                <div class="relative" @onmouseenter="OpenCategoryMenu" @onmouseleave="CloseCategoryMenu">
                    <button
                        class="flex items-center gap-2 bg-neutral-900 text-amber-300 px-5 py-3 text-xs font-semibold uppercase tracking-wider rounded-b-xl hover:bg-neutral-800 transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
                        </svg>
                        Danh mục sản phẩm
                    </button>

                    @if (IsCategoryMenuOpen)
                    {
                        <!-- Level-1: overflow-visible so level-2 flyout isn't clipped -->
                        <div
                            class="absolute top-full left-0 z-50 w-72 max-w-[calc(100vw-2rem)] bg-white rounded-2xl shadow-2xl border border-neutral-100 py-2 overflow-visible">
                            @foreach (var cat in Categories)
                            {
                                <div class="relative" @onmouseenter="() => SetActiveCategory(cat.Id)">
                                    <a href="@cat.Url"
                                       class="flex items-center gap-3 px-5 py-3 text-sm text-neutral-800 hover:bg-amber-50 hover:text-amber-900 transition-colors">
                                        <img src="@cat.IconUrl" alt="" class="w-5 h-5 object-contain" loading="lazy" />
                                        <span>@cat.Name</span>
                                        @if (cat.SubCategories.Any())
                                        {
                                            <svg class="w-3.5 h-3.5 ml-auto text-neutral-400" fill="none" stroke="currentColor"
                                                 stroke-width="2" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round"
                                                      d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                                            </svg>
                                        }
                                    </a>

                                    @if (ActiveCategoryId == cat.Id && cat.SubCategories.Any())
                                    {
                                        <div
                                            class="absolute left-full top-0 ml-1 z-50 w-80 max-w-[calc(100vw-21rem)] bg-white rounded-2xl shadow-2xl border border-neutral-100 py-3 px-4 max-h-[70vh] overflow-y-auto">
                                            <h3 class="text-sm font-bold text-neutral-900 mb-3 px-2">@cat.Name</h3>
                                            @foreach (var sub in cat.SubCategories)
                                            {
                                                <a href="@sub.Url"
                                                   class="block px-3 py-2 text-sm text-neutral-600 rounded-lg hover:bg-amber-50 hover:text-amber-900 transition-colors">
                                                    @sub.Name
                                                </a>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </nav>

        <!-- Search bar: w-full + min-w-0 so the input fills and borders clip correctly -->
        <div class="flex-1 min-w-0 relative">
            <input @bind="SearchQuery" @onkeydown="HandleSearchKeydown" type="text"
                   placeholder="Tìm tại đây vô vàn sản phẩm cà phê chính hãng từ tập đoàn Trung Nguyên Legend..."
                   class="w-full h-11 pl-4 pr-10 rounded-b-xl border border-neutral-300 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-amber-500 placeholder:text-neutral-400 transition-all" />
            <button @onclick="ExecuteSearch" aria-label="Tìm kiếm"
                    class="absolute right-1 top-1/2 -translate-y-1/2 w-9 h-9 flex items-center justify-center rounded-lg bg-neutral-900 text-white hover:bg-neutral-700 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
                </svg>
            </button>
        </div>

        <button @onclick="ToggleCart" aria-label="Giỏ hàng"
                class="relative flex items-center gap-2 h-11 px-4 rounded-b-xl border border-neutral-300 hover:border-neutral-900 hover:shadow-md transition-all shrink-0">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
            </svg>
            <div class="text-left">
                <span class="block text-xs text-neutral-500">Giỏ hàng</span>
                <span class="block text-sm font-semibold text-neutral-900">@CartItemCount</span>
            </div>
            @if (CartItemCount > 0)
            {
                <span
                    class="absolute -top-1.5 -right-1.5 w-5 h-5 bg-red-500 text-white text-xs rounded-full flex items-center justify-center font-bold">
                    @CartItemCount 
                </span>
            }
        </button>
    </div>
</header>

<!-- HERO CAROUSEL -->
<section class="max-w-7xl mx-auto px-5 mt-5">
    <div class="relative overflow-hidden rounded-2xl shadow-lg">
        <div class="flex transition-transform duration-500 ease-in-out"
             style="transform: translateX(-@(CurrentSlide * 100)%);">
            @foreach (var banner in Banners)
            {
                <div class="w-full shrink-0">
                    @if (!string.IsNullOrEmpty(banner.LinkUrl))
                    {
                        <a href="@banner.LinkUrl" target="@(banner.OpenNewTab ? "_blank" : "_self")">
                            <img src="@banner.ImageUrl" alt="@banner.AltText" class="w-full aspect-[2025/748] object-cover"
                                 loading="lazy" />
                        </a>
                    }
                    else
                    {
                        <img src="@banner.ImageUrl" alt="@banner.AltText" class="w-full aspect-[2025/748] object-cover"
                             loading="lazy" />
                    }
                </div>
            }
        </div>
        <button @onclick="PrevSlide" aria-label="Trước"
                class="absolute left-3 top-1/2 -translate-y-1/2 w-10 h-10 bg-white/80 backdrop-blur rounded-full flex items-center justify-center shadow-md hover:bg-white transition-colors">
            <svg class="w-5 h-5 text-neutral-800" fill="none" stroke="currentColor" stroke-width="2"
                 viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
            </svg>
        </button>
        <button @onclick="NextSlide" aria-label="Sau"
                class="absolute right-3 top-1/2 -translate-y-1/2 w-10 h-10 bg-white/80 backdrop-blur rounded-full flex items-center justify-center shadow-md hover:bg-white transition-colors">
            <svg class="w-5 h-5 text-neutral-800" fill="none" stroke="currentColor" stroke-width="2"
                 viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
            </svg>
        </button>
        <div class="absolute bottom-3 left-1/2 -translate-x-1/2 flex gap-2">
            @for (int i = 0; i < Banners.Count; i++)
            {
                var idx = i;
                <button @onclick="() => GoToSlide(idx)" aria-label="Slide @(idx + 1)"
                        class="h-2.5 rounded-full transition-all duration-300 @(idx == CurrentSlide ? "bg-white w-6" : "bg-white/50 w-2.5 hover:bg-white/80")"></button>
            }
        </div>
    </div>
</section>

<!-- TRUST BADGES -->
<section class="max-w-7xl mx-auto px-5 mt-5">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        @foreach (var badge in TrustBadges)
        {
            <div class="flex items-center gap-3 bg-neutral-900 rounded-xl px-4 py-3">
                <div class="w-9 h-9 shrink-0 flex items-center justify-center text-amber-400">@((MarkupString)badge.SvgIcon)
                </div>
                <span class="text-xs text-neutral-100 leading-snug">@badge.Text</span>
            </div>
        }
    </div>
</section>

<!-- PRODUCT SECTIONS -->
@foreach (var section in ProductSections)
{
    <section class="max-w-7xl mx-auto px-5 mt-10">
        <div class="text-center mb-6">
            <h2 class="text-2xl font-semibold text-neutral-900 tracking-wide">@section.Title</h2>
            @if (!string.IsNullOrEmpty(section.Description))
            {
                <p class="text-sm text-neutral-500 mt-1">@section.Description</p>
            }
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
            @foreach (var product in section.Products)
            {
                <ProductCard Product="product" OnAddToCart="AddToCart" />
            }
        </div>
        <div class="text-center mt-6">
            <a href="@section.ViewAllUrl"
               class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-neutral-900 text-white text-sm font-medium hover:bg-neutral-700 transition-colors">
                Xem thêm
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M17.25 8.25l-6.75 6.75m0 0l-6.75-6.75m6.75 6.75V3" />
                </svg>
            </a>
        </div>
    </section>
}




<!-- FOOTER -->
<footer class="bg-neutral-900 text-neutral-300">
    <div class="max-w-7xl mx-auto px-5 py-12">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-8">
            <div class="flex items-start">
                <a href="https://trungnguyenlegend.com/" target="_blank">
                    <img src="https://cafe.net.vn/static/version1790340732/frontend/Trungnguyen/default/vi_VN/images/footer-logo.png"
                         alt="Trung Nguyen Legend" class="h-24 w-auto object-contain" loading="lazy" />
                </a>
            </div>
            <div>
                <h3 class="text-xs font-bold uppercase tracking-wider text-amber-400 mb-4">Về chúng tôi</h3>
                <ul class="space-y-2 text-xs">
                    @foreach (var link in AboutLinks)
                    {
                        <li><a href="@link.Url" class="hover:text-white transition-colors">@link.Text</a></li>
                    }
                </ul>
            </div>
            <div>
                <h3 class="text-xs font-bold uppercase tracking-wider text-amber-400 mb-4">Đối tác thanh toán</h3>
                <div class="flex flex-wrap gap-2 mb-4">
                    @foreach (var pm in PaymentMethods)
                    {
                        <div class="bg-white rounded-lg p-1.5 flex items-center justify-center w-14 h-9">
                            <img src="@pm.ImageUrl" alt="@pm.Name" class="max-h-6 w-auto object-contain" loading="lazy" />
                        </div>
                    }
                </div>
                <a href="/thanh-toan-an-toan/"
                   class="text-xs text-amber-400 hover:text-amber-300 transition-colors">Cách thức thanh toán</a>
            </div>
            <div>
                <h3 class="text-xs font-bold uppercase tracking-wider text-amber-400 mb-4">Đối tác vận chuyển</h3>
                <ul class="space-y-2 text-xs">
                    <li><a href="/giao-hang-toan-quoc/" class="hover:text-white transition-colors">Chính sách giao
                        nhận</a></li>
                        <li><a href="/chinh-sach-bao-hanh/" class="hover:text-white transition-colors">Chính sách bảo
                            hành</a></li>
                            <li><a href="/doi-hang/" class="hover:text-white transition-colors">Chính sách đổi trả</a></li>
                        </ul>
                    </div>
                    <div>
                        <h3 class="text-xs font-bold uppercase tracking-wider text-amber-400 mb-4">Liên hệ</h3>
                        <div class="space-y-2 text-xs leading-relaxed">
                            <p><strong>Trụ sở chính:</strong> 82-84 Bùi Thị Xuân, P. Bến Thành, TP.HCM, Việt Nam.</p>
                            <p><strong>VP nhà máy:</strong> 268 Nguyễn Tất Thành, P. Tân Lập, Tỉnh Đắk Lắk, Việt Nam.</p>
                            <p><strong>Showroom:</strong> 324-326 Nguyễn Đình Chiểu, P. Bàn Cờ, TP.HCM, Việt Nam.</p>
                            <p><strong>Đơn vị chủ quản:</strong> Công ty Cổ phần Tập Đoàn Trung Nguyên.</p>
                            <p>Số ĐKKD: 0304324655</p>
                            <p><strong>ĐƯỜNG DÂY NÓNG:</strong> <span class="text-lg font-bold text-amber-400">1900 6016</span>
                            </p>
                        </div>
                    </div>
                </div>
                <div class="border-t border-neutral-800 mt-10 pt-6 text-center text-xs text-neutral-500">&copy;2019 Trung Nguyen
                    Legend. All rights reserved.</div>
                </div>
            </footer>

            <!-- STICKY BUTTONS -->
            <div class="fixed bottom-6 right-6 flex flex-col gap-3 z-50">
                <a href="https://zalo.me/1498942390064218601" target="_blank" aria-label="Chat Zalo"
                   class="w-12 h-12 rounded-full bg-blue-600 flex items-center justify-center shadow-lg hover:bg-blue-500 hover:scale-110 transition-all">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z" />
                    </svg>
                </a>
                <a href="tel:19006016" aria-label="Gọi điện"
                   class="w-12 h-12 rounded-full bg-emerald-600 flex items-center justify-center shadow-lg hover:bg-emerald-500 hover:scale-110 transition-all">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                    </svg>
                </a>
            </div>

            <!-- AUTH MODAL -->
            @if (IsAuthModalOpen)
            {
                <div class="fixed inset-0 z-[100] flex items-center justify-center p-4">
                    <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" @onclick="ToggleAuthModal"></div>
                    <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-lg p-8 animate-in">
                        <button @onclick="ToggleAuthModal" aria-label="Đóng"
                                class="absolute top-4 right-4 w-8 h-8 rounded-full bg-neutral-100 flex items-center justify-center hover:bg-neutral-200 transition-colors">
                            <svg class="w-4 h-4 text-neutral-600" fill="none" stroke="currentColor" stroke-width="2"
                                 viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        </button>
                        @if (AuthMode == AuthView.Login)
                        {
                            <h2 class="text-xl font-semibold text-neutral-900 mb-6">Đăng nhập để tiếp tục</h2>
                            <div class="space-y-4">
                                <div>
                                    <label class="block text-sm text-neutral-700 mb-1">Email</label>
                                    <input @bind="LoginEmail" type="email" placeholder="Nhập địa chỉ email đã đăng ký"
                                           class="w-full h-11 px-4 rounded-xl border border-neutral-300 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500" />
                                </div>
                                <div>
                                    <label class="block text-sm text-neutral-700 mb-1">Mật khẩu</label>
                                    <input @bind="LoginPassword" type="password" placeholder="Điền mật khẩu"
                                           class="w-full h-11 px-4 rounded-xl border border-neutral-300 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500" />
                                </div>
                                <div class="flex items-center justify-between">
                                    <label class="flex items-center gap-2 text-sm text-neutral-600 cursor-pointer">
                                        <input type="checkbox" @bind="RememberMe" class="w-4 h-4 rounded border-neutral-300" />
                                        Nhớ tài khoản
                                    </label>
                                    <button @onclick="() => AuthMode = AuthView.ForgotPassword"
                                            class="text-sm text-amber-700 hover:underline">Quên mật khẩu</button>
                                </div>
                                <button @onclick="HandleLogin"
                                        class="w-full h-11 rounded-xl bg-neutral-900 text-white text-sm font-semibold hover:bg-neutral-700 transition-colors">Đăng
                                    nhập</button>
                                </div>
                            }
            else
                            {
                                <h2 class="text-xl font-semibold text-neutral-900 mb-2">Quên mật khẩu</h2>
                                <p class="text-sm text-neutral-500 mb-6">Vui lòng nhập địa chỉ email của bạn dưới đây để nhận được một liên kết
                                    đặt lại mật khẩu.</p>
                                    <div class="space-y-4">
                                        <div>
                                            <label class="block text-sm text-neutral-700 mb-1">Email</label>
                                            <input @bind="ForgotEmail" type="email" placeholder="Điền email"
                                                   class="w-full h-11 px-4 rounded-xl border border-neutral-300 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500" />
                                        </div>
                                        <button @onclick="HandleForgotPassword"
                                                class="w-full h-11 rounded-xl bg-neutral-900 text-white text-sm font-semibold hover:bg-neutral-700 transition-colors">Lấy
                                            lại mật khẩu</button>
                                            <button @onclick="() => AuthMode = AuthView.Login"
                                                    class="w-full text-sm text-amber-700 hover:underline">Quay lại đăng nhập</button>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <!-- CART DRAWER -->
                        @if (IsCartOpen)
                        {
                            <div class="fixed inset-0 z-[100]">
                                <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" @onclick="ToggleCart"></div>
                                <div
                                    class="absolute right-0 top-0 h-full w-full max-w-md bg-white shadow-2xl flex flex-col rounded-l-2xl overflow-hidden">
                                    <div class="flex items-center justify-between px-6 py-4 border-b border-neutral-100">
                                        <h2 class="text-lg font-semibold text-neutral-900">Giỏ hàng</h2>
                                        <button @onclick="ToggleCart" aria-label="Đóng"
                                                class="w-8 h-8 rounded-full bg-neutral-100 flex items-center justify-center hover:bg-neutral-200 transition-colors">
                                            <svg class="w-4 h-4 text-neutral-600" fill="none" stroke="currentColor" stroke-width="2"
                                                 viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                                            </svg>
                                        </button>
                                    </div>
                                    <div class="flex-1 overflow-y-auto px-6 py-4">
                                        @if (CartItems.Count == 0)
                                        {
                                            <div class="flex flex-col items-center justify-center h-full text-center">
                                                <svg class="w-24 h-24 text-neutral-200 mb-4" fill="none" stroke="currentColor" stroke-width="1"
                                                     viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                          d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007z" />
                                                </svg>
                                                <p class="text-neutral-400 text-sm">Bạn chưa có sản phẩm nào trong giỏ hàng.</p>
                                            </div>
                                        }
                                        else
                                        {
                                            @foreach (var item in CartItems)
                                            {
                                                <div class="flex gap-3 py-3 border-b border-neutral-100 last:border-0">
                                                    <img src="@item.ImageUrl" alt="@item.Name" class="w-16 h-16 rounded-xl object-cover bg-neutral-100" />
                                                    <div class="flex-1 min-w-0">
                                                        <p class="text-sm font-medium text-neutral-900 truncate">@item.Name</p>
                                                        <p class="text-xs text-neutral-500 mt-0.5">Số lượng: @item.Quantity</p>
                                                        <p class="text-sm font-semibold text-red-600 mt-1">@item.Price.ToString("N0") ₫</p>
                                                    </div>
                                                    <button @onclick="() => RemoveFromCart(item.Id)" aria-label="Xóa"
                                                            class="self-start w-6 h-6 rounded-full flex items-center justify-center text-neutral-400 hover:text-red-500 hover:bg-red-50 transition-colors">
                                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                                                        </svg>
                                                    </button>
                                                </div>
                                            }
                                        }
                                    </div>
                                    @if (CartItems.Count > 0)
                                    {
                                        <div class="px-6 py-4 border-t border-neutral-100">
                                            <div class="flex justify-between items-center mb-4">
                                                <span class="text-sm text-neutral-600">Tạm tính (đã bao gồm VAT)</span>
                                                <span class="text-lg font-bold text-neutral-900">@CartTotal.ToString("N0") ₫</span>
                                            </div>
                                            <button
                                                class="w-full h-11 rounded-xl bg-neutral-900 text-white text-sm font-semibold hover:bg-neutral-700 transition-colors">Tiến
                                                hành thanh toán</button>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- TOAST -->
                            @if (!string.IsNullOrEmpty(ToastMessage))
                            {
                                <div
                                    class="fixed bottom-20 left-1/2 -translate-x-1/2 z-[200] bg-neutral-900 text-white text-sm px-5 py-3 rounded-xl shadow-lg flex items-center gap-2 animate-bounce-in">
                                    <svg class="w-5 h-5 text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd"
                                              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                                              clip-rule="evenodd" />
                                    </svg>
                                    @ToastMessage
                                </div>
                            }

